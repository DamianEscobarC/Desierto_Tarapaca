<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_white_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NUEVO CLIENTE / FAENA"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogRut"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_field"
        android:hint="RUT (ej: 76.123.456-7)"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_main"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etDialogNombre"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Nombre o Razón Social"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_main"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etDialogDireccion"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Dirección"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_main"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/btnElegirEnMapaDialogo"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_field"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/tvCoordenadasSeleccionadas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📍 Toca para fijar ubicación en mapa"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗺️ ELEGIR"
            android:textColor="#2D5A43"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/etDialogTelefono"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Teléfono de contacto"
        android:inputType="phone"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_main"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogCancelar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:text="Cancelar"
            android:textColor="@color/text_main" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDialogGuardar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_finalizar"
            android:text="Guardar"
            android:textColor="@color/text_light" />
    </LinearLayout>

</LinearLayout>